{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^P(2030|2050|2100)-\\d{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "horizon": {
      "type": "number",
      "enum": [
        2030,
        2050,
        2100
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "forecast",
        "structural"
      ]
    },
    "proxy": {
      "type": "string",
      "minLength": 1
    },
    "conditional_on": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^P(2030|2050|2100)-\\d{3}$"
      }
    },
    "resolution_date": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "created": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "probability": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    },
    "probability_basis": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "watch": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "statement",
          "watch"
        ],
        "additionalProperties": false
      }
    },
    "checkpoint_date": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "checkpoint_signal": {
      "type": "string",
      "minLength": 1
    },
    "resolution_criteria": {
      "type": "string",
      "minLength": 1
    },
    "resolution_source": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "checkpoint_met",
        "checkpoint_missed",
        "resolved_true",
        "resolved_false",
        "ambiguous",
        "withdrawn"
      ]
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "accessed": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          }
        },
        "required": [
          "title",
          "url",
          "accessed"
        ],
        "additionalProperties": false
      }
    },
    "revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "probability": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "date",
          "probability",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resolved_on": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "resolution_note": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "title",
    "claim",
    "horizon",
    "resolution_date",
    "created",
    "probability",
    "probability_basis",
    "assumptions",
    "checkpoint_date",
    "checkpoint_signal",
    "resolution_criteria",
    "resolution_source",
    "status",
    "sources"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/ibrahimkarakira/horizon-arch/blob/main/schema/prediction.schema.json",
  "title": "horizon-arch prediction",
  "description": "Field shapes only. Cross-field rules (id matches horizon, checkpoint window, resolution fields, structural kind and proxy) and cross-file rules (conditional_on ids exist, no cycles) are enforced by predictionSchema in schema/prediction.schema.mjs and scripts/validate-predictions.mjs."
}
